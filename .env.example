# Neon Postgres connection string.
# Auto-injected by Vercel when you run `vercel install neon`.
# Locally: copy the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# The PIN that unlocks the app. Use at least 6 characters — longer is better,
# and a short passphrase beats a 4-digit number.
APP_PIN="change-me"

# Secret used to sign the session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this instantly logs out every device.
SESSION_SECRET="change-me-to-32-plus-random-bytes"